# Optional public IPv6 address used only for the startup log.
IPV6=

# Configure STUN/TURN; valores TURN enviados ao navegador são visíveis aos peers.
# Prefira credenciais TURN temporárias em produção.
# ICE_SERVERS aceita um array JSON, por exemplo:
# ICE_SERVERS=[{"urls":["stun:stun.seudominio:3478"]}]
ICE_SERVERS=
# Alternativa ao JSON:
STUN_URL=
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Ative apenas atrás de proxy confiável que sobrescreve X-Forwarded-For.
TRUST_PROXY=0
